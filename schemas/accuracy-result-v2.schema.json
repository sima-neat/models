{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sima-neat/models/schemas/accuracy-result-v2.schema.json",
  "title": "SiMa Neat model accuracy result v2",
  "description": "Task metrics measured on a declared dataset with compiled MPKs. Metric names and meanings belong to the model's validation entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "validation", "dataset", "metrics", "execution"],
  "properties": {
    "schema_version": {"const": 2},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "build_profile_id", "component_id", "package_id", "artifacts"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "build_profile_id": {"$ref": "#/$defs/id"},
        "component_id": {"$ref": "#/$defs/id", "description": "Component whose results carry this accuracy."},
        "package_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "artifacts": {
          "description": "SHA-256 of each compiled MPK the measurement ran, by component.",
          "type": "object", "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false, "required": ["id", "engine", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "engine": {"const": "devkit_script"},
        "status": {"enum": ["ready", "provisional"]}
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "variant", "split", "sha256", "evaluated_samples", "available_samples"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "evaluated_samples": {"type": "integer", "minimum": 1},
        "available_samples": {"type": "integer", "minimum": 1}
      }
    },
    "metrics": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/metric"}
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["core_version", "script_sha256", "models_commit"],
      "properties": {
        "core_version": {"type": "string", "minLength": 1},
        "script_sha256": {"$ref": "#/$defs/sha256"},
        "models_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "details": {"type": "object", "description": "Script-specific context such as timings; not compared or published as measurements."}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metric": {
      "type": "object", "additionalProperties": false, "required": ["value", "unit", "direction"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "direction": {"enum": ["higher", "lower"]},
        "reference": {"type": ["number", "null"], "description": "Value of the same metric for the source model, when measured."}
      }
    }
  }
}
