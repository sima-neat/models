{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.neat.sima.ai/model-registry/accuracy-v1.schema.json",
  "title": "SiMa Neat Model Registry accuracy evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine",
    "status",
    "task",
    "dataset",
    "profiles",
    "executors",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "engine": {"const": "model_registry"},
    "status": {"enum": ["ready", "provisional", "pending"]},
    "task": {"const": "image_classification"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "executors": {"$ref": "#/$defs/executors"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "samples"],
      "properties": {
        "prefix": {"type": "string", "minLength": 1},
        "samples": {"type": "integer", "minimum": 1},
        "classes": {"type": "integer", "minimum": 1},
        "label_strategy": {"enum": ["none", "lexicographic_parent_directory"]}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variant", "sha256", "size_bytes", "loader", "splits"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "variant": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "loader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "image_suffixes"],
          "properties": {
            "type": {"const": "image_classification_tar"},
            "image_suffixes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9.]+$"}
            }
          }
        },
        "splits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calibration", "validation"],
          "properties": {
            "calibration": {"$ref": "#/$defs/split"},
            "validation": {"$ref": "#/$defs/split"}
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_scope", "samples", "sampling", "workers"],
      "properties": {
        "report_scope": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "samples": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"const": "all"}
          ]
        },
        "sampling": {"enum": ["deterministic_evenly_spaced"]},
        "workers": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"const": "auto"}
          ]
        },
        "cadence": {"type": "string", "minLength": 1}
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "artifact", "input_layout"],
      "properties": {
        "type": {"enum": ["onnxruntime", "afe_sima"]},
        "artifact": {"enum": ["source", "compile_variant"]},
        "input_layout": {"enum": ["NCHW", "NHWC"]},
        "use_jax": {"type": "boolean"}
      }
    },
    "executors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "candidate"],
      "properties": {
        "reference": {"$ref": "#/$defs/executor"},
        "candidate": {"$ref": "#/$defs/executor"}
      }
    },
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "k"],
          "properties": {
            "type": {"const": "top_k_accuracy"},
            "k": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "top1_agreement"}
          }
        }
      ]
    }
  }
}
