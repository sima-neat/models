{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.neat.sima.ai/model-registry/model.schema.json",
  "title": "SiMa Neat Model Registry model.yaml",
  "description": "What a model is and what its compile stage and benchmarks must produce. Each build profile compiles every component in one compile.py call; scripts/performance.py and scripts/accuracy.py measure the whole model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "display_name", "description", "model_type", "tasks",
    "modalities", "architecture", "license", "compilation", "build_profiles"
  ],
  "properties": {
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "build-on-demand": {"type": "boolean", "default": false},
    "model_type": {"$ref": "#/$defs/id"},
    "tasks": {"$ref": "#/$defs/idSet"},
    "modalities": {
      "type": "object", "additionalProperties": false, "required": ["inputs", "outputs"],
      "properties": {"inputs": {"$ref": "#/$defs/idSet"}, "outputs": {"$ref": "#/$defs/idSet"}}
    },
    "architecture": {"$ref": "#/$defs/id"},
    "license": {
      "type": "object", "additionalProperties": false, "required": ["spdx", "redistribution", "attribution"],
      "properties": {
        "spdx": {"type": "string", "minLength": 1},
        "redistribution": {"enum": ["allowed", "restricted", "prohibited", "unknown"]},
        "attribution": {"type": "string", "minLength": 1}
      }
    },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1},
        "model_card": {"type": "string", "format": "uri", "pattern": "^https://"},
        "derived_from": {"type": "string", "format": "uri"}
      }
    },
    "conversion": {
      "description": "The source scripts/convert.py turns into compilation.source.",
      "type": "object", "additionalProperties": false, "required": ["source"],
      "properties": {"source": {"$ref": "#/$defs/source"}}
    },
    "compilation": {
      "description": "The source scripts/compile.py (ONNX) or scripts/compile.sh (Hugging Face) compiles, and the components it must produce. One component is named model.",
      "type": "object", "additionalProperties": false, "required": ["format", "source"],
      "properties": {
        "format": {"enum": ["onnx", "huggingface"]},
        "source": {"oneOf": [{"$ref": "#/$defs/source"}, {"const": "conversion"}]},
        "components": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "entrypoint": {"description": "The package's public entrypoint when it is not default, such as generate.", "$ref": "#/$defs/id"}
      }
    },
    "calibrations": {
      "description": "What build profiles calibrate on: a Dataset Registry dataset, named by its source ID such as coco-2017-cal.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "dataset"],
        "properties": {"id": {"$ref": "#/$defs/datasetId"}, "dataset": {"$ref": "#/$defs/dataset"}}
      }
    },
    "build_profiles": {
      "type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["components"],
        "properties": {
          "runner_class": {"$ref": "#/$defs/runnerClass"}, "runner_market": {"enum": ["spot", "on-demand"]},
          "benchmark_baseline": {
            "type": "object", "additionalProperties": false, "required": ["model_id", "build_profile"],
            "properties": {
              "model_id": {"$ref": "#/$defs/id"}, "build_profile": {"$ref": "#/$defs/id"}
            }
          },
          "calibration_dataset": {"description": "A calibrations entry.", "$ref": "#/$defs/datasetId"},
          "components": {
            "description": "Each component's build parameters, keyed like compilation.components.",
            "type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/id"},
            "additionalProperties": {
              "type": "object", "additionalProperties": false, "required": ["parameters"],
              "properties": {"parameters": {"type": "object"}, "runner_class": {"$ref": "#/$defs/runnerClass"}, "runner_market": {"enum": ["spot", "on-demand"]}}
            }
          }
        }
      }
    },
    "pipeline": {
      "description": "How the model runs, for the browser; orchestration stays in the scripts.",
      "type": "array", "minItems": 2,
      "items": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["component"], "properties": {"component": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["cpu"], "properties": {"cpu": {"type": "string", "minLength": 1}}}
      ]}
    },
    "numerical_fidelity": {
      "description": "Compiled outputs compared against the source model by scripts/compile.py.",
      "type": "object", "additionalProperties": false, "required": ["status", "dataset", "selection", "outputs"],
      "properties": {
        "status": {"enum": ["diagnostic", "provisional", "ready"]},
        "dataset": {"$ref": "#/$defs/dataset"},
        "selection": {
          "type": "object", "additionalProperties": false, "required": ["method", "seed", "offset", "samples"],
          "properties": {
            "method": {"const": "seeded_random_without_replacement"},
            "seed": {"type": "integer", "minimum": 0}, "offset": {"type": "integer", "minimum": 0},
            "samples": {"type": "integer", "minimum": 1}
          }
        },
        "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "accuracy": {
      "description": "The datasets scripts/accuracy.py evaluates the whole model on, on a DevKit. datasets/<id>.yaml says which metrics each dataset requires for the model's tasks.",
      "type": "object", "additionalProperties": false, "required": ["datasets"],
      "properties": {
        "datasets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataset"}},
        "build_profiles": {"$ref": "#/$defs/profileIds"}
      }
    },
    "performance": {
      "description": "Measures the whole model with scripts/performance.py on a DevKit. Every report must hold the metrics tools/model_report/metrics.json marks required.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "build_profiles": {"$ref": "#/$defs/profileIds"}
      }
    },
    "reference_metrics": {
      "description": "Scores the source model's authors published for these weights, copied from a pinned page.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source", "dataset", "conditions", "metrics"],
        "properties": {
          "source": {"type": "string", "format": "uri", "pattern": "^https://"},
          "dataset": {
            "type": "object", "additionalProperties": false, "required": ["id", "split"],
            "properties": {"id": {"$ref": "#/$defs/datasetId"}, "split": {"$ref": "#/$defs/datasetId"}}
          },
          "conditions": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "metrics": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"type": "number"}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "idSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "profileIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "runnerClass": {"enum": ["default", "moderate", "expensive", "most-expensive"]},
    "datasetId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "sourceUri": {
      "type": "string", "minLength": 1,
      "pattern": "^(?:hf://(?:models|datasets|spaces)/[^@/]+/[^@/]+@[a-f0-9]{40}/.+|https://.+)$"
    },
    "source": {
      "oneOf": [
        {
          "description": "One file.",
          "type": "object", "additionalProperties": false, "required": ["uri", "sha256", "size_bytes"],
          "properties": {
            "uri": {"$ref": "#/$defs/sourceUri"}, "sha256": {"$ref": "#/$defs/sha256"},
            "size_bytes": {"type": "integer", "minimum": 1}, "media_type": {"type": "string", "minLength": 1}
          }
        },
        {
          "description": "A set of files, such as a Hugging Face checkpoint; main_file is the one the recipe opens.",
          "type": "object", "additionalProperties": false, "required": ["main_file", "files"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[^/@]+/[^/@]+$"},
            "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "main_file": {"$ref": "#/$defs/relativePath"},
            "files": {
              "type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/relativePath"},
              "additionalProperties": {
                "type": "object", "additionalProperties": false, "required": ["sha256", "size_bytes"],
                "properties": {
                  "uri": {"$ref": "#/$defs/sourceUri"}, "sha256": {"$ref": "#/$defs/sha256"},
                  "size_bytes": {"type": "integer", "minimum": 1}, "media_type": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      ]
    },
    "dataset": {
      "type": "object", "additionalProperties": false, "required": ["id", "variant", "sha256", "size_bytes"],
      "properties": {
        "id": {"$ref": "#/$defs/datasetId"}, "variant": {"$ref": "#/$defs/datasetId"},
        "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
