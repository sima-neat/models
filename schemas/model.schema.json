{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.neat.sima.ai/model-registry/model.schema.json",
  "title": "SiMa Neat Model Registry model.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "display_name", "description", "model_type", "tasks",
    "modalities", "architecture", "owners", "license", "upstream", "components", "resources",
    "calibrations", "build_profiles", "compositions", "packages", "tests", "maturity"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"$ref": "#/$defs/id"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "model_type": {"$ref": "#/$defs/taxonomyId"},
    "tasks": {"$ref": "#/$defs/taxonomyIdSet"},
    "modalities": {"$ref": "#/$defs/modalities"},
    "architecture": {"$ref": "#/$defs/architecture"},
    "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/taxonomyId"}},
    "owners": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^@[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?$"}
    },
    "license": {"$ref": "#/$defs/license"},
    "upstream": {"$ref": "#/$defs/upstream"},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "calibrations": {"type": "array", "items": {"$ref": "#/$defs/calibration"}},
    "build_profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/buildProfile"}},
    "compositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/composition"}},
    "packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/package"}},
    "tests": {"$ref": "#/$defs/tests"},
    "maturity": {"enum": ["experimental", "staging", "approved", "deprecated"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "taxonomyId": {"$ref": "#/$defs/id"},
    "taxonomyIdSet": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/taxonomyId"}
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "modalities": {
      "type": "object", "additionalProperties": false, "required": ["inputs", "outputs"],
      "properties": {
        "inputs": {"$ref": "#/$defs/taxonomyIdSet"}, "outputs": {"$ref": "#/$defs/taxonomyIdSet"}
      }
    },
    "architectureComponent": {
      "type": "object", "additionalProperties": false, "required": ["role", "architecture_id"],
      "properties": {
        "role": {"$ref": "#/$defs/taxonomyId"}, "architecture_id": {"$ref": "#/$defs/taxonomyId"}
      }
    },
    "architecture": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/taxonomyId"},
        "variant": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/architectureComponent"}}
      }
    },
    "license": {
      "type": "object", "additionalProperties": false, "required": ["spdx", "redistribution", "attribution"],
      "properties": {
        "spdx": {"type": "string", "minLength": 1},
        "redistribution": {"enum": ["allowed", "restricted", "prohibited", "unknown"]},
        "attribution": {"type": "string", "minLength": 1}
      }
    },
    "upstream": {
      "type": "object", "additionalProperties": false, "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1},
        "model_card": {"type": "string", "format": "uri"},
        "derived_from": {"type": "string", "format": "uri"}
      }
    },
    "sourceUri": {
      "type": "string", "minLength": 1,
      "pattern": "^(?:hf://(?:models|datasets|spaces)/[^@/]+/[^@/]+@[a-f0-9]{40}/.+|https://.+)$"
    },
    "sourceFile": {
      "type": "object", "additionalProperties": false, "required": ["path", "uri", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"}, "uri": {"$ref": "#/$defs/sourceUri"},
        "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "uri", "sha256", "size_bytes"],
          "properties": {
            "type": {"const": "file"}, "uri": {"$ref": "#/$defs/sourceUri"},
            "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1},
            "media_type": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "entrypoint", "files"],
          "properties": {
            "type": {"const": "file_set"}, "entrypoint": {"$ref": "#/$defs/relativePath"},
            "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceFile"}}
          }
        }
      ]
    },
    "dimension": {
      "oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}]
    },
    "tensor": {
      "type": "object", "additionalProperties": false, "required": ["name", "dtype", "shape"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dtype": {"enum": ["float16", "bfloat16", "float32", "float64", "int8", "uint8", "int16", "uint16", "int32", "uint32", "int64", "uint64", "bool", "string"]},
        "shape": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
        "layout": {"type": "string", "minLength": 1}, "description": {"type": "string"}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "input", "output", "initialization", "lifetime"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "input": {"type": "string", "minLength": 1},
        "output": {"type": "string", "minLength": 1},
        "initialization": {"enum": ["zero", "provided", "component"]},
        "lifetime": {"enum": ["invocation", "session", "stream"]}
      }
    },
    "entrypoint": {
      "type": "object", "additionalProperties": false, "required": ["id", "inputs", "outputs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/tensor"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/tensor"}},
        "state": {"type": "array", "items": {"$ref": "#/$defs/state"}},
        "streaming": {
          "type": "object", "additionalProperties": false, "required": ["mode"],
          "properties": {
            "mode": {"enum": ["chunked", "autoregressive"]}, "reset": {"type": "boolean"},
            "flush": {"type": "boolean"}, "parameters": {"type": "object"}
          }
        }
      }
    },
    "shapeProfile": {
      "type": "object", "additionalProperties": false, "required": ["id", "entrypoint", "bindings"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "entrypoint": {"$ref": "#/$defs/id"},
        "bindings": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "interface": {
      "type": "object", "additionalProperties": false, "required": ["format", "entrypoints", "shape_profiles"],
      "properties": {
        "format": {"const": "onnx"}, "opset": {"type": "integer", "minimum": 1},
        "entrypoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entrypoint"}},
        "shape_profiles": {"type": "array", "items": {"$ref": "#/$defs/shapeProfile"}}
      }
    },
    "pipelineStage": {
      "type": "object", "additionalProperties": false, "required": ["op", "parameters"],
      "properties": {"op": {"$ref": "#/$defs/id"}, "parameters": {"type": "object"}}
    },
    "pipeline": {
      "type": "object", "additionalProperties": false, "required": ["pipeline"],
      "properties": {"pipeline": {"type": "array", "items": {"$ref": "#/$defs/pipelineStage"}}}
    },
    "surgery": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "none"}}},
        {
          "type": "object", "additionalProperties": false, "required": ["type", "entrypoint", "parameters"],
          "properties": {
            "type": {"const": "python"},
            "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.py:[A-Za-z_][A-Za-z0-9_]*$"},
            "parameters": {"type": "object"}
          }
        }
      ]
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "source", "interface", "preprocessing", "postprocessing", "surgery", "recipe"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/source"},
        "interface": {"$ref": "#/$defs/interface"}, "preprocessing": {"$ref": "#/$defs/pipeline"},
        "postprocessing": {"$ref": "#/$defs/pipeline"}, "surgery": {"$ref": "#/$defs/surgery"},
        "recipe": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.py$"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["id", "source", "install_path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/source"},
        "install_path": {"$ref": "#/$defs/relativePath"}, "optional": {"type": "boolean"},
        "license": {"$ref": "#/$defs/license"}
      }
    },
    "datasetRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "variant", "sha256", "size_bytes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "variant": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "calibration": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id", "status", "reason"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "status": {"const": "pending"}, "reason": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "status", "source"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "status": {"const": "ready"}, "source": {"$ref": "#/$defs/source"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "status", "dataset"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "status": {"const": "ready"}, "dataset": {"$ref": "#/$defs/datasetRef"}}
        }
      ]
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "device_family": {"type": "string", "minLength": 1},
        "platform_version": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1}
      }
    },
    "buildComponent": {
      "type": "object", "additionalProperties": false, "required": ["id", "parameters"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "runner_class": {"enum": ["default", "expensive", "most-expensive"]},
        "shape_profile": {"$ref": "#/$defs/id"}, "calibration": {"$ref": "#/$defs/id"},
        "artifact_suffix": {"$ref": "#/$defs/id", "not": {"pattern": "[^a-z0-9_]"}},
        "parameters": {"type": "object"}, "status": {"enum": ["supported", "unsupported"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "unsupported"}}, "required": ["status"]}, "then": {"required": ["reason"]}}]
    },
    "compileInvocation": {
      "type": "object", "additionalProperties": false, "required": ["id", "components"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "components": {
          "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}
        },
        "python_packages": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/pythonPackage"}
        }
      }
    },
    "pythonPackage": {
      "type": "object", "additionalProperties": false, "required": ["path", "imports"],
      "properties": {
        "path": {"allOf": [{"$ref": "#/$defs/relativePath"}, {"pattern": "\\.whl$"}]},
        "imports": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"}
        }
      }
    },
    "buildProfile": {
      "type": "object", "additionalProperties": false, "required": ["id", "target", "components"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "target": {"type": "string", "minLength": 1},
        "runner_class": {"enum": ["default", "expensive", "most-expensive"]},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/buildComponent"}},
        "compile_invocations": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/compileInvocation"}
        }
      }
    },
    "composition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id", "type", "component", "entrypoint"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "type": {"const": "single"},
            "component": {"$ref": "#/$defs/id"}, "entrypoint": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "type", "schema_version", "file"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "type": {"const": "declarative"},
            "schema_version": {"type": "integer", "minimum": 1}, "file": {"$ref": "#/$defs/relativePath"}
          }
        }
      ]
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "default", "components", "resources", "build_profiles", "composition"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "default": {"type": "boolean"},
        "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "resources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "build_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "composition": {"$ref": "#/$defs/id"},
        "maturity": {"enum": ["experimental", "staging", "approved", "deprecated"]}
      }
    },
    "testScope": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "component"],
          "properties": {"type": {"const": "component"}, "component": {"$ref": "#/$defs/id"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "package"],
          "properties": {"type": {"const": "package"}, "package": {"$ref": "#/$defs/id"}}
        }
      ]
    },
    "testCase": {
      "type": "object", "additionalProperties": false, "required": ["id", "config", "scope", "build_profiles"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "config": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.ya?ml$"},
        "scope": {"$ref": "#/$defs/testScope"},
        "build_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "tests": {
      "type": "object", "additionalProperties": false, "required": ["correctness", "performance"],
      "properties": {
        "correctness": {"type": "array", "items": {"$ref": "#/$defs/testCase"}},
        "performance": {"type": "array", "items": {"$ref": "#/$defs/testCase"}}
      }
    }
  }
}
