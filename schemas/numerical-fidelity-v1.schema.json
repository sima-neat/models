{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sima.ai/model-registry/numerical-fidelity-v1.schema.json",
  "title": "Model Registry numerical fidelity result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "build_profile_id",
    "component_id",
    "scope",
    "status",
    "dataset",
    "selection",
    "thresholds",
    "samples",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "model_id": {"$ref": "#/$defs/id"},
    "build_profile_id": {"$ref": "#/$defs/id"},
    "component_id": {"$ref": "#/$defs/id"},
    "scope": {"enum": ["component", "full_pipeline"]},
    "status": {"enum": ["provisional", "ready"]},
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "variant", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "seed", "offset", "samples"],
      "properties": {
        "method": {"const": "seeded_random_without_replacement"},
        "seed": {"type": "integer", "minimum": 0},
        "offset": {"type": "integer", "minimum": 0},
        "samples": {"type": "integer", "minimum": 1}
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_cosine_similarity", "maximum_normalized_rmse"],
      "properties": {
        "minimum_cosine_similarity": {"type": "number", "minimum": -1, "maximum": 1},
        "maximum_normalized_rmse": {"type": "number", "minimum": 0}
      }
    },
    "samples": {"type": "integer", "minimum": 1},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cosine_similarity", "normalized_rmse", "mean_absolute_error", "max_absolute_error"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "cosine_similarity": {"type": "number", "minimum": -1, "maximum": 1},
          "normalized_rmse": {"type": "number", "minimum": 0},
          "mean_absolute_error": {"type": "number", "minimum": 0},
          "max_absolute_error": {"type": "number", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
  }
}
