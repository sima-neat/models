{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sima.ai/model-registry/package-manifest.schema.json",
  "title": "Model Registry retrieval package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id", "display_name", "package_id", "build_profile_id",
    "composition", "target", "provenance", "components", "resources", "files", "license"
  ],
  "properties": {
    "model_id": {"$ref": "#/$defs/id"},
    "display_name": {"type": "string", "minLength": 1},
    "package_id": {"$ref": "#/$defs/id"},
    "build_profile_id": {"$ref": "#/$defs/id"},
    "composition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "component", "entrypoint"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "type": {"const": "single"},
            "component": {"$ref": "#/$defs/id"},
            "entrypoint": {"$ref": "#/$defs/id"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "path"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "type": {"const": "declarative"},
            "path": {"$ref": "#/$defs/path"}
          }
        }
      ]
    },
    "target": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "additionalProperties": {"type": "string"}},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "path", "sha256", "size_bytes", "source_sha256", "compile_run_id"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "role": {"$ref": "#/$defs/id"},
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "compile_run_id": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "source_sha256", "size_bytes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "license": {"$ref": "#/$defs/license"}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "license": {"$ref": "#/$defs/license"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "redistribution", "attribution"],
      "properties": {
        "spdx": {"type": "string", "minLength": 1},
        "redistribution": {"enum": ["allowed", "restricted", "prohibited", "unknown"]},
        "attribution": {"type": "string", "minLength": 1}
      }
    }
  }
}
