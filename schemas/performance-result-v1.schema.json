{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sima-neat/models/schemas/performance-result-v1.schema.json",
  "title": "SiMa Neat synthetic model performance result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "benchmark_type", "tool", "identity", "timestamp_utc",
    "model", "compatibility", "configuration", "environment", "power_measurement",
    "metrics", "trials", "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["passed", "error"]},
    "benchmark_type": {"const": "model.synthetic"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "benchmarker"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization_version", "fingerprint"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization_version": {"const": 1},
        "fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "failure_classification": {
      "type": ["string", "null"],
      "enum": [null, "configuration", "compatibility", "model", "benchmark", "infrastructure"]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variant_id", "path", "sha256", "uri", "contract"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "variant_id": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "uri": {"type": ["string", "null"]},
        "contract": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["name", "model_sdk_version", "elf_count", "mla_stage_count", "compiled_batch_size", "mla_stages"],
          "properties": {
            "name": {"type": ["string", "null"]},
            "model_sdk_version": {"type": ["string", "null"]},
            "elf_count": {"type": "integer", "minimum": 0},
            "mla_stage_count": {"type": "integer", "minimum": 0},
            "compiled_batch_size": {"type": ["integer", "null"], "minimum": 1},
            "mla_stages": {"type": "array", "items": {"type": "string"}}
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": ["postprocess", "output_topology", "input_specs", "output_specs"],
          "properties": {
            "postprocess": {"type": ["string", "null"]},
            "output_topology": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["physical", "logical", "packed"],
              "properties": {
                "physical": {"type": "integer", "minimum": 0},
                "logical": {"type": "integer", "minimum": 0},
                "packed": {"type": "boolean"}
              }
            },
            "input_specs": {"type": "array", "items": {"$ref": "#/$defs/tensorSpec"}},
            "output_specs": {"type": "array", "items": {"$ref": "#/$defs/tensorSpec"}}
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_platform_version", "actual_platform_version", "expected_neat_version", "actual_neat_version"],
      "properties": {
        "expected_platform_version": {"type": ["string", "null"]},
        "actual_platform_version": {"type": ["string", "null"]},
        "expected_neat_version": {"type": ["string", "null"]},
        "actual_neat_version": {"type": ["string", "null"]}
      }
    },
    "configuration": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["samples", "trials", "include_plugin_latency", "original_width", "original_height", "model_options"],
      "properties": {
        "samples": {"type": "integer", "minimum": 1},
        "trials": {"type": "integer", "minimum": 1, "maximum": 100},
        "include_plugin_latency": {"type": "boolean"},
        "original_width": {"type": ["integer", "null"], "minimum": 1},
        "original_height": {"type": ["integer", "null"], "minimum": 1},
        "model_options": {"type": "object"}
      }
    },
    "environment": {"$ref": "#/$defs/environment"},
    "power_measurement": {"$ref": "#/$defs/powerMeasurement"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_avg_ms", "latency_p50_ms", "latency_p95_ms", "throughput_fps",
        "avg_power_watts", "energy_joules", "energy_per_inference_joules"
      ],
      "properties": {
        "latency_avg_ms": {"$ref": "#/$defs/metric"},
        "latency_p50_ms": {"$ref": "#/$defs/metric"},
        "latency_p95_ms": {"$ref": "#/$defs/metric"},
        "throughput_fps": {"$ref": "#/$defs/metric"},
        "avg_power_watts": {"$ref": "#/$defs/metric"},
        "energy_joules": {"$ref": "#/$defs/metric"},
        "energy_per_inference_joules": {"$ref": "#/$defs/metric"}
      }
    },
    "trials": {"type": "array", "items": {"$ref": "#/$defs/trial"}},
    "provenance": {"type": "object"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "error"}}},
      "then": {"required": ["error"]}
    }
  ],
  "$defs": {
    "tensorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "shape": {"type": "array", "items": {"type": "integer"}},
        "rank": {"type": "integer"},
        "dtypes": {"type": "array", "items": {"type": "string"}},
        "image_format": {"type": ["string", "null"]},
        "device": {"type": ["string", "null"]},
        "preferred_device": {"type": ["string", "null"]},
        "allowed_devices": {"type": "array", "items": {"type": "string"}},
        "allow_composite": {"type": "boolean"},
        "required_segment_names": {"type": "array", "items": {"type": "string"}},
        "error": {"type": "string"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "reason", "unit", "aggregation", "value", "minimum", "maximum",
        "standard_deviation", "sample_count"
      ],
      "properties": {
        "status": {"enum": ["measured", "unavailable", "unsupported"]},
        "reason": {"type": ["string", "null"]},
        "unit": {"type": "string"},
        "aggregation": {"const": "mean"},
        "value": {"type": ["number", "null"]},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "standard_deviation": {"type": ["number", "null"], "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 0}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial", "latency_avg_ms", "latency_p50_ms", "latency_p95_ms", "throughput_fps",
        "avg_power_watts", "energy_joules", "energy_per_inference_joules"
      ],
      "properties": {
        "trial": {"type": "integer", "minimum": 1},
        "latency_avg_ms": {"type": "number", "exclusiveMinimum": 0},
        "latency_p50_ms": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "latency_p95_ms": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "throughput_fps": {"type": "number", "exclusiveMinimum": 0},
        "avg_power_watts": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "energy_joules": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "energy_per_inference_joules": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_utc", "load_average", "temperatures_c"],
      "properties": {
        "timestamp_utc": {"type": "string", "format": "date-time"},
        "load_average": {"type": "array", "items": {"type": "number"}},
        "temperatures_c": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sensor", "celsius"],
            "properties": {
              "sensor": {"type": "string"},
              "celsius": {"type": "number"}
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint_version", "fingerprint", "board_model", "machine", "kernel_release",
        "platform_version", "neat_version", "cpu_count", "cpu_governor", "build_information", "observations"
      ],
      "properties": {
        "fingerprint_version": {"const": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "board_model": {"type": ["string", "null"]},
        "machine": {"type": ["string", "null"]},
        "kernel_release": {"type": ["string", "null"]},
        "platform_version": {"type": ["string", "null"]},
        "neat_version": {"type": ["string", "null"]},
        "cpu_count": {"type": ["integer", "null"], "minimum": 1},
        "cpu_governor": {"type": ["string", "null"]},
        "build_information": {"type": "object", "additionalProperties": {"type": "string"}},
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"$ref": "#/$defs/observation"},
            "end": {"anyOf": [{"$ref": "#/$defs/observation"}, {"type": "null"}]}
          }
        }
      }
    },
    "powerMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "phase", "source", "idle_baseline_subtracted", "telemetry_preflight"],
      "properties": {
        "scope": {"const": "board_pmbus_rails"},
        "phase": {"const": "throughput"},
        "source": {"const": "pyneat.Model.benchmark"},
        "idle_baseline_subtracted": {"const": false},
        "telemetry_preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "runtime_user", "required_group", "devices"],
          "properties": {
            "status": {"enum": ["available", "unavailable"]},
            "reason": {"type": ["string", "null"]},
            "runtime_user": {"type": "string"},
            "required_group": {"const": "i2c"},
            "devices": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "readable", "writable"],
                "properties": {
                  "path": {"type": "string"},
                  "readable": {"type": "boolean"},
                  "writable": {"type": "boolean"}
                }
              }
            }
          }
        }
      }
    }
  }
}
