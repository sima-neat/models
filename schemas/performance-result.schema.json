{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sima-neat/models/schemas/performance-result.schema.json",
  "title": "SiMa Neat model performance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "benchmark_type", "tool", "identity", "timestamp_utc",
    "model", "compatibility", "configuration", "environment", "benchmark_report",
    "execution_plan", "orchestration", "provenance"
  ],
  "properties": {
    "schema_version": {"const": 6},
    "status": {"enum": ["passed", "error"]},
    "benchmark_type": {"enum": ["model.synthetic", "model.generative"]},
    "tool": {
      "type": "object", "required": ["name", "version"], "additionalProperties": false,
      "properties": {"name": {"enum": ["pyneat.Model.benchmark", "MoLE / LLiMa web"]}, "version": {"type": "string", "minLength": 1}}
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "canonicalization_version", "fingerprint"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "canonicalization_version": {"const": 5},
        "fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "failure_classification": {
      "type": ["string", "null"],
      "enum": [null, "configuration", "compatibility", "model", "benchmark", "infrastructure"]
    },
    "model": {
      "type": "object", "required": ["id", "build_profile_id", "component_id", "path", "sha256", "uri", "contract"],
      "properties": {
        "id": {"type": ["string", "null"]}, "build_profile_id": {"type": ["string", "null"]},
        "component_id": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "uri": {"type": ["string", "null"]}, "contract": {"type": ["object", "null"]},
        "resolved": {"type": "object"}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_platform_version", "actual_platform_version", "expected_neat_version", "actual_neat_version"],
      "properties": {
        "expected_platform_version": {"type": ["string", "null"]},
        "actual_platform_version": {"type": ["string", "null"]},
        "expected_neat_version": {"type": ["string", "null"]},
        "actual_neat_version": {"type": ["string", "null"]}
      }
    },
    "configuration": {"type": ["object", "null"]},
    "environment": {"type": "object", "required": ["fingerprint", "fingerprint_version"],
      "properties": {
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fingerprint_version": {"const": 2},
        "mla_frequency_hz": {"type": ["integer", "null"], "minimum": 1},
        "cpu_frequency_khz": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "benchmark_report": {"description": "The tool's saved report, unchanged.", "type": "object"},
    "execution_plan": {
      "description": "The Core execution plan, or null for LLiMa.",
      "type": ["object", "null"],
      "required": ["schema", "schema_version"]
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "session_id", "task_id", "attempt", "target_correlation_id"],
      "properties": {
        "provider": {"enum": ["github-actions-devkit-runner", "manual"]},
        "session_id": {"type": ["string", "null"]},
        "task_id": {"type": ["string", "null"]},
        "attempt": {"type": ["integer", "null"], "minimum": 1},
        "target_correlation_id": {"type": ["string", "null"]}
      }
    },
    "provenance": {"type": "object"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {"type": {"type": "string"}, "message": {"type": "string"}}
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "error"}}},
    "then": {"required": ["error"]}
  }, {
    "if": {"properties": {"benchmark_type": {"const": "model.generative"}}},
    "then": {"properties": {
      "benchmark_report": {"$ref": "#/$defs/generativeReport"},
      "tool": {"properties": {"name": {"const": "MoLE / LLiMa web"}}},
      "execution_plan": {"type": "null"}
    }},
    "else": {"properties": {
      "benchmark_report": {"$ref": "#/$defs/coreReport"},
      "tool": {"properties": {"name": {"const": "pyneat.Model.benchmark"}}},
      "execution_plan": {"type": "object"}
    }}
  }],
  "$defs": {
    "coreReport": {
      "description": "The report BenchmarkReport.save() wrote, unchanged; later Core fields pass through.",
      "type": "object",
      "required": [
        "latency_ms", "latency_p50_ms", "latency_p95_ms", "latency_p99_ms", "fps", "avg_power_watts",
        "energy_joules", "peak_power_watts", "throughput_duration_ms", "throughput_samples", "telemetry",
        "layer_stats"
      ],
      "properties": {
        "latency_ms": {"$ref": "#/$defs/reportNumber"},
        "latency_p50_ms": {"$ref": "#/$defs/reportNumber"},
        "latency_p95_ms": {"$ref": "#/$defs/reportNumber"},
        "latency_p99_ms": {"$ref": "#/$defs/reportNumber"},
        "fps": {"$ref": "#/$defs/reportNumber"},
        "avg_power_watts": {"$ref": "#/$defs/reportNumber"},
        "energy_joules": {"$ref": "#/$defs/reportNumber"},
        "peak_power_watts": {"$ref": "#/$defs/reportNumber"},
        "throughput_duration_ms": {"$ref": "#/$defs/reportNumber"},
        "throughput_samples": {"type": "integer", "minimum": 0},
        "telemetry": {
          "type": "object",
          "required": [
            "status", "samples", "power_som_watts", "power_mla_watts", "power_rails_watts",
            "die_temperature_max_c", "board_temperatures_c", "cpu_usage_pct", "cpu_cores_usage_pct",
            "mla_memory_mib", "cma_memory_mib", "linux_memory_used_mib"
          ],
          "properties": {
            "status": {"type": "string"},
            "samples": {"type": "integer", "minimum": 0},
            "power_som_watts": {"$ref": "#/$defs/telemetryMetric"},
            "power_mla_watts": {"$ref": "#/$defs/telemetryMetric"},
            "power_rails_watts": {"type": "array", "items": {"$ref": "#/$defs/telemetryMetric"}},
            "die_temperature_max_c": {"$ref": "#/$defs/telemetryMetric"},
            "board_temperatures_c": {"type": "array", "items": {"$ref": "#/$defs/telemetryMetric"}},
            "cpu_usage_pct": {"$ref": "#/$defs/telemetryMetric"},
            "cpu_cores_usage_pct": {"type": "array", "items": {"$ref": "#/$defs/telemetryMetric"}},
            "mla_memory_mib": {"$ref": "#/$defs/telemetryMetric"},
            "cma_memory_mib": {"$ref": "#/$defs/telemetryMetric"},
            "linux_memory_used_mib": {"$ref": "#/$defs/telemetryMetric"}
          }
        },
        "layer_stats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "stage_index", "total_execution_time_us"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "stage_index": {"type": "integer", "minimum": 0},
              "total_execution_time_us": {"$ref": "#/$defs/reportNumber"}
            }
          }
        }
      }
    },
    "generativeReport": {
      "type": "object",
      "required": ["status", "settings", "workloads", "timing", "runtime"],
      "properties": {
        "status": {"const": "passed"},
        "settings": {"type": "object"},
        "workloads": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "kind", "requests", "metrics", "telemetry", "throughput_duration_ms"],
            "properties": {
              "telemetry": {"$ref": "#/$defs/coreReport/properties/telemetry"},
              "throughput_duration_ms": {"$ref": "#/$defs/reportNumber"},
              "avg_power_watts": {"$ref": "#/$defs/reportNumber"},
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "kind": {"enum": ["text", "image_text"]},
              "input_tokens": {"type": "integer", "minimum": 1},
              "image_size": {
                "type": "array", "minItems": 2, "maxItems": 2,
                "items": {"type": "integer", "minimum": 1}
              },
              "requests": {
                "type": "array", "minItems": 6, "maxItems": 6,
                "items": {
                  "type": "object", "required": ["phase", "ttft_s"],
                  "properties": {
                    "phase": {"enum": ["warmup", "measure"]},
                    "ttft_s": {"type": "number", "exclusiveMinimum": 0}
                  }
                }
              },
              "metrics": {"type": "object"}
            }
          }
        },
        "timing": {"type": "object"},
        "runtime": {"type": "object"}
      }
    },
    "reportNumber": {"type": "number", "minimum": 0},
    "telemetryMetric": {
      "type": "object",
      "required": ["key", "label", "unit", "samples", "mean", "minimum", "maximum"],
      "properties": {
        "key": {"type": "string"},
        "label": {"type": "string"},
        "unit": {"type": "string"},
        "samples": {"type": "integer", "minimum": 0},
        "mean": {"type": "number"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    }
  }
}
