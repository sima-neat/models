{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sima-neat/models/schemas/performance-test-v1.schema.json",
  "title": "SiMa Neat synthetic model performance test v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "compatibility", "benchmark"],
  "properties": {
    "schema_version": {"const": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variant_id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "uri": {"type": "string", "minLength": 1}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_version", "neat_version"],
      "properties": {
        "platform_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "neat_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples"],
      "properties": {
        "mode": {"enum": ["bounded_runner"]},
        "samples": {"type": "integer", "minimum": 1},
        "trials": {"type": "integer", "minimum": 1, "maximum": 100, "default": 3},
        "warmup_samples": {"type": "integer", "minimum": 1},
        "include_plugin_latency": {"type": "boolean", "default": false},
        "original_width": {"type": "integer", "minimum": 1},
        "original_height": {"type": "integer", "minimum": 1}
      }
    },
    "model_options": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      },
      "default": {}
    },
    "provenance": {"type": "object", "default": {}}
  }
}
