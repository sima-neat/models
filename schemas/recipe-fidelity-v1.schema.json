{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sima.ai/model-registry/recipe-fidelity-v1.schema.json",
  "title": "Model recipe numerical fidelity configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine",
    "status",
    "result_component",
    "dataset",
    "selection",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "engine": {"const": "model_recipe"},
    "status": {"enum": ["diagnostic", "provisional", "ready"]},
    "result_component": {"$ref": "#/$defs/id"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variant", "sha256", "size_bytes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "variant": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "seed", "offset", "samples"],
      "properties": {
        "method": {"const": "seeded_random_without_replacement"},
        "seed": {"type": "integer", "minimum": 0},
        "offset": {"type": "integer", "minimum": 0},
        "samples": {"type": "integer", "minimum": 1}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
  }
}
