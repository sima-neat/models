+            return self
+        terminal = self.mlp.fc2
+        if not isinstance(terminal, nn.Conv2d):
+            raise RuntimeError(
+                "LocalBlock layer-scale folding requires the terminal "
+                "Conv2d_BN to be fused first"
+            )
+        scale = self.layer_scale.reshape(-1).to(
+            device=terminal.weight.device, dtype=terminal.weight.dtype
+        )
+        terminal.weight.mul_(scale[:, None, None, None])
+        if terminal.bias is None:
+            terminal.bias = nn.Parameter(torch.zeros_like(scale))
+        else:
+            terminal.bias.mul_(scale)
+        self.use_layer_scale = False
+        self.register_parameter("layer_scale", None)
+        return self
