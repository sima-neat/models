+    def fold_layer_scale_into_mlp(self):
+        """Fold the inference layer-scale multiply into the terminal 1x1 conv.
+
+        This is an exact deployment reparameterization after ``Conv2d_BN``
+        modules have been fused.  It removes a separately requantized multiply
+        immediately before the residual add, while preserving the original
+        PyTorch function and trainable source checkpoint.
